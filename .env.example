# Google Gemini - https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Steam Web API - https://steamcommunity.com/dev/apikey
# Required for library + achievement data. Server-side only, never exposed to the browser.
STEAM_WEB_API_KEY=

# OPTIONAL, local development only.
#
# eve's dev workflow queue re-discovers its own internal port via netstat plus
# a 500ms probe race on every delivery, because withEve() spawns its child on
# --port 0 and never tells that child its own address. Under Turbopack compile
# load the probe misses, the queue reports "fetch failed", and a turn can hang.
#
# To avoid it, run eve as its own process on a fixed port and point Next at it:
#
#   WORKFLOW_LOCAL_BASE_URL=http://127.0.0.1:4278 \
#     npx eve dev --no-ui --port 4278
#
# ...then uncomment the line below and run `npm run dev` in a second terminal.
# Leave it commented to let withEve() manage eve itself (simpler, but prone to
# the retry loop above).
#
# EVE_BASE_URL=http://127.0.0.1:4278
